---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('incidents')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { nodes } = (await getEntry('topology', 'thales'))!.data;
const involved = entry.data.focus.map((id) => nodes.find((n) => n.id === id)!);
---
<Base title={entry.data.title} description={entry.data.dek}>
  <article>
    <p class="label"><a href="/incidents/">Incidents</a></p>
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.dek}</p>
    <div class="prose">
      <Content />
    </div>
    <section>
      <h2>Hosts involved</h2>
      <ul class="hosts">
        {involved.map((n) => (
          <li data-layer={n.layer}>{n.id} <span>{n.role}</span></li>
        ))}
      </ul>
    </section>
  </article>
</Base>
