---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('incidents')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.dek}>
  <article>
    <p class="label"><a href="/incidents/">Incidents</a></p>
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.dek}</p>
    <div class="prose">
      <Content />
    </div>
    <section>
      <h2>Systems involved</h2>
      <ul class="stages">
        {entry.data.focus.map((name) => <li>{name}</li>)}
      </ul>
    </section>
  </article>
</Base>
