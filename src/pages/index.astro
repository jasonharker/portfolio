---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

// The essay is the landing page and the sky is its backdrop (M5). Headings come from the same
// chapters the asterisms are built from, so a chapter can never be lit with no words under it, or
// read with no figure behind it. The bodies are lorem until the real prose lands; they are sized to
// what will replace them so the scroll, the chapter lighting and the tests all exercise the real
// thing.
const { chapters } = (await getEntry('topology', 'thales'))!.data;
const body: Record<string, string[]> = {
  warehouse: [
    'When I was 14 the family computer had a hardware failure, so I scrapped together a new one. Rather than install Windows Vista I chose a Debian distro called Crunchbang. Thus began a lifelong obsession with Linux and FOSS technology. ',
    'I was so indecisive about what I wanted to do when I grew up. It never occurred to me that this hobby could be my career, or that Id be good at it.',
  ],
  philosophy: [
    'In high school I got sick and I started spending way more time on the computer. I was bedridden--scrubbing StackOverflow for help with Makefiles, installing Gentoo, learning Python--instead of going to class.',
    'But I still graduated on-time at 17 thanks to summer school. I worked in factories and warehouses for a few years after high school until I enrolled in UNLV to study one of my other passions, Philosophy.',
  ],
  'vet-med': [
    'While studying in college, I took a job at a veterinary hospital. I\'d spend the duration of the pandemic working in the field.',
    'Eventually I started studying for the CompTIA A+ on my lunch breaks, got my certification, and began aggressively pursuing help desk jobs until Circa took a chance on me.',
  ],
  'casino-it': [
    'At Circa I was prompty promoted to Desktop Support Specialist. About a year later, I was promoted to Sysadmin, and about a year after that, I let slip that I run a sophisticated K8s cluster in my homelab and was promoted to Cloud Engineer not long after.',
    'Stick the landing.',
  ],
};
---
<Base bodyClass="landing">
  <h1>Lorem ipsum dolor sit amet</h1>
  <p class="dek">Consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
  <article class="essay">
    {chapters.map((chapter) => (
      <section class="prose" data-chapter={chapter.id}>
        {(body[chapter.id] ?? []).map((p) => <p>{p}</p>)}
      </section>
    ))}
  </article>
</Base>
