---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const { nodes } = (await getEntry('topology', 'thales'))!.data;
// Last commit date of topology.yaml, passed in by Jenkins (.git isn't in the build context). || not ??: Jenkins may pass ''.
const asOf = import.meta.env.TOPOLOGY_DATE || 'unknown';
const layers = [
  { id: 'physical', name: 'Physical' },
  { id: 'proxmox', name: 'Proxmox' },
  { id: 'kubernetes', name: 'Kubernetes' },
  { id: 'services', name: 'Services' },
];
---
<Base>
  <h1>Lorem ipsum dolor sit amet</h1>
  <p class="dek">Consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
  <div class="prose">
    <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
  </div>
  <div class="layers">
    {layers.map((layer) => (
      <section data-layer={layer.id}>
        <h2>{layer.name}</h2>
        <ul class="hosts">
          {nodes.filter((n) => n.layer === layer.id).map((n) => (
            <li>{n.id} <span>{n.role}</span></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="dek">Topology as of {asOf}</p>
</Base>
