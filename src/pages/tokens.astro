---
import Base from '../layouts/Base.astro';

// Design review page (spec §6): every token rendered once, checked against the avoid list
// before any scene code. Not linked from the menu; remove before production promotion.
const ground = ['--ground', '--ground-raised', '--ink', '--muted', '--rule'];
const stars = ['--star-30000', '--star-12000', '--star-8500', '--star-6800', '--star-5600', '--star-4300', '--star-3000'];
const steps = ['--step-4', '--step-3', '--step-2', '--step-1', '--step-0', '--step--1'];
const avoid = [
  'Cream ground, serif type, terracotta accent',
  'Near-black ground with a single neon accent',
  'Rounded cards, drop shadows, gradient washes',
  'Uppercase eyebrow labels',
  'Middot-separated meta strings',
  'Monospace labels',
  'Arrows on links',
];
---
<Base title="Tokens" noindex>
  <h1>Tokens</h1>
  <p class="dek">Every design token on one page, for review against the avoid list.</p>

  <h2>Ground and ink</h2>
  <ul class="swatches">
    {ground.map((t) => <li style={`--swatch: var(${t})`}><code>{t}</code></li>)}
  </ul>

  <h2>Blackbody accents</h2>
  <ul class="swatches">
    {stars.map((t) => <li style={`--swatch: var(${t})`}><code>{t}</code></li>)}
  </ul>
  <ul class="hosts">
    <li data-layer="physical">Physical <span>3000 K</span></li>
    <li data-layer="proxmox">Proxmox <span>4300 K</span></li>
    <li data-layer="kubernetes">Kubernetes <span>5600 K</span></li>
    <li data-layer="services">Services <span>12000 K</span></li>
  </ul>

  <h2>Type scale</h2>
  {steps.map((t) => <p style={`font-size: var(${t}); line-height: 1.25`}>Lorem ipsum dolor sit amet</p>)}

  <h2>Reading sample</h2>
  <div class="prose">
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud <a href="/incidents/">exercitation ullamco</a> laboris nisi ut aliquip ex ea commodo consequat.</p>
    <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
    <pre><code>lorem:
  ipsum: dolor
  sit: amet</code></pre>
  </div>
  <p class="label">Planet label</p>

  <h2>Avoid</h2>
  <ul>
    {avoid.map((a) => <li>{a}</li>)}
  </ul>
</Base>
