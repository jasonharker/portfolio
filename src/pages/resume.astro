  { role: 'Sed ut perspiciatis', org: 'Unde omnis iste', when: 'Natus error — sit voluptatem', points: ['Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit.', 'Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet.'] },
