---
import Base from '../layouts/Base.astro';

// Titles, employers and dates as on Jason's LinkedIn; the paper title leads, the working title follows in parentheses.
const experience = [
  { role: 'Sportsbook Deployment Engineer (Cloud Engineer)', org: 'Circa Resort & Casino', when: 'Jun 2026 – Present', points: ['Run the AKS clusters behind Circa\'s mobile sports-betting app, deployed through Flux and Helm, with separate staging and production branches.', 'Moved RabbitMQ onto zone-redundant storage in staging, after disks pinned to one zone broke the cluster during node upgrades.', 'Building New Relic alerting for failed pods and failed deployments.'] },
  { role: 'IT System Administrator', org: 'Circa Resort & Casino', when: 'Apr 2025 – Jun 2026', points: ['Managed Oracle Simphony POS and Opera PMS for three properties and more than 500 employees.', 'Administered the Nutanix cluster hosting the resort\'s virtualized workloads, from VM provisioning to storage and cluster health.', 'Built XML reports that combine payment, tax and operational data, replacing a manual reconciliation.', 'Tuned the Oracle database queries and indexes behind business reporting.', 'Took Tier 2 and 3 escalations and trained junior support staff.'] },
  { role: 'Desktop Support (hired as IT Help Desk Technician)', org: 'Circa Resort & Casino', when: 'Mar 2024 – Apr 2025', points: ['Ran the Super Bowl and March Madness builds: temporary sportsbooks and bar POS stations across Circa and the D, installed around conventions and torn down the night of the game.', 'Disconnected the betting terminals at close and confirmed each shutdown to Compliance.', 'First call for POS and cage hardware on the casino floor, from pin pads and ticket printers to signature pads and card embossers.', 'Built and deployed cage workstations, configuring the cash-handling software and its peripherals at cutover.'] },
  { role: 'Veterinary Assistant', org: 'Creature Comforts Animal Hospital', when: 'Mar 2022 – Dec 2023', points: [] },
];

const certifications = [
  'CompTIA Security+ (May 2026)',
  'CompTIA Secure Infrastructure Specialist (May 2026)',
  'CompTIA Network+ (Feb 2026)',
  'CompTIA IT Operations Specialist (Feb 2026)',
  'CompTIA A+ (Jan 2024)',
];
---
<Base title="Resume" bodyClass="resume">
  <h1>Jason Harker</h1>
  <p class="dek">Cloud engineer at Circa in Las Vegas, running Kubernetes on Azure at work and on my own hardware at home.</p>
  <div class="cv">
    <h2>Summary</h2>
    <section>
      <p>I deploy and operate the Kubernetes platform behind Circa's mobile sportsbook on Azure. At home I run THALES, a private cloud on Proxmox and Ceph with a Talos Kubernetes cluster managed through Flux, and this site documents it. I came to IT from veterinary medicine and a philosophy degree.</p>
    </section>

    <h2>Experience</h2>
    <section>
      {experience.map((e) => (
        <div class="entry">
          <h3>{e.role}, {e.org}</h3>
          <p class="when">{e.when}</p>
          {e.points.length > 0 && <ul>{e.points.map((p) => <li>{p}</li>)}</ul>}
        </div>
      ))}
    </section>

    <h2>Education</h2>
    <section>
      <div class="entry">
        <h3>BA, Philosophy, University of Nevada, Las Vegas</h3>
        <p class="when">2016 – 2020</p>
        <p>Cum laude. Phi Sigma Tau.</p>
      </div>
    </section>

    <h2>Certifications</h2>
    <section>
      {certifications.map((c) => <p>{c}</p>)}
    </section>

    <h2>Skills</h2>
    <section>
      <p>Kubernetes, Talos Linux, Flux CD, Helm, Cilium, Azure Kubernetes Service, Proxmox, Ceph, Nutanix AHV, HashiCorp Vault, External Secrets Operator, Prometheus, Grafana, Loki, New Relic, Jenkins, Terraform, Ansible, Oracle Simphony, Oracle Opera, Oracle Database, SQL, Python, Bash, PowerShell, Linux, Windows Server, Active Directory, pfSense.</p>
    </section>
  </div>
</Base>
