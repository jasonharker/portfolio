---
import { getCollection, getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';
import '../styles/scene-labels.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.', bodyClass, noindex } = Astro.props;
const fullTitle = title ? `${title} — Jason Harker` : 'Jason Harker';
const path = Astro.url.pathname;
const nav = [
  { href: '/incidents/', label: 'Incidents' },
  { href: '/gitops/', label: 'GitOps' },
  { href: '/documentation/', label: 'Documentation' },
  { href: '/resume/', label: 'Resume' },
];
// A JSON data block is never executed, so script-src 'self' allows it. Escape '<' so no
// value can close the tag.
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const topology = json((await getEntry('topology', 'thales'))!.data);
// One planet per incident in the Local orrery, best first. Only what the scene draws: no prose.
const incidents = json(
  (await getCollection('incidents'))
    .sort((a, b) => a.data.order - b.data.order)
    .map((e) => ({ slug: e.id, label: e.data.label, order: e.data.order, focus: e.data.focus })),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d16" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <div class="scene" aria-hidden="true" transition:persist="scene"><canvas></canvas></div>
    <div class="scene-labels" transition:persist="scene-labels"></div>
    <script type="application/json" id="topology" is:inline set:html={topology} />
    <script type="application/json" id="incidents" is:inline set:html={incidents} />
    <header class="masthead">
      <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>Jason Harker</a>
      <nav aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <button class="look" type="button" aria-pressed="false">Look around</button>
    </header>
    <main class="column">
      <slot />
    </main>
    <script>
      // Runs once; ClientRouter swaps the page around it. Listeners on swapped elements
      // rebind on astro:page-load, listeners on document bind once.
      const set = (on: boolean) => {
        document.documentElement.toggleAttribute('data-look', on);
        const button = document.querySelector<HTMLButtonElement>('.look')!;
        button.setAttribute('aria-pressed', String(on));
        button.textContent = on ? 'Back to reading' : 'Look around';
      };
      document.addEventListener('astro:page-load', () => {
        document.querySelector('.look')!.addEventListener('click', () => set(!document.documentElement.hasAttribute('data-look')));
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));

      // The scene, after first paint and only past the gates (spec §5). Never by device class.
      // Reduced motion still gets the scene, as still frames.
      addEventListener('load', async () => {
        if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return;
        const canvas = document.querySelector<HTMLCanvasElement>('.scene canvas')!;
        const gl = canvas.getContext('webgl2', { antialias: false, powerPreference: 'high-performance' });
        if (!gl) return;
        const { start } = await import('../scene/index');
        start(canvas, gl, document.querySelector('.scene-labels')!);
      }, { once: true });
    </script>
  </body>
</html>
